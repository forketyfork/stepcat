{
  "name": "stepcat",
  "version": "0.1.0",
  "description": "Step-by-step agent orchestration solution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stepcat": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:backend && npm run postbuild",
    "build:backend": "tsc",
    "postbuild": "node -e \"const fs = require('fs'); const p = 'dist/cli.js'; const nodePath = process.execPath; let content = fs.readFileSync(p, 'utf8'); content = content.replace(/^#!.*\\n/, ''); content = '#!' + nodePath + '\\n' + content; fs.writeFileSync(p, content); fs.chmodSync(p, '755');\"",
    "start": "node dist/cli.js",
    "dev": "npm run build:backend && node dist/cli.js",
    "test": "jest && vitest run",
    "test:jest": "jest",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint backend",
    "lint:backend": "eslint backend"
  },
  "keywords": [
    "orchestration",
    "agent",
    "claude",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.63",
    "@octokit/rest": "^22.0.1",
    "@openai/codex": "^0.107.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "diff": "^8.0.3"
  }
}
